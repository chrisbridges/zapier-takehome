meta {
  name: "Replay idempotent request"
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/usage
  body: json
  auth: none
}

headers {
  Content-Type: "application/json"
  Idempotency-Key: "{{idempotencyKey}}"
}

body:json {
  {
    "customerId": ""{{customerId}}"",
  "service": "{{service}}",
  "unitsConsumed": ""{{unitsConsumed}}"",
  "pricePerUnit": ""{{pricePerUnit}}""
  }
}
