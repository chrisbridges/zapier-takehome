meta {
  name: "Record usage"
  type: "http"
  seq: 1
}

post {
  url: {{baseUrl}}/usage
  body: json
}

headers {
  Content-Type: "application/json"
  Idempotency-Key: "{{idempotencyKey}}"
}

body:json {
  {
    "customerId": "{{customerId}}",
    "service": "{{service}}",
    "unitsConsumed": "{{unitsConsumed}}",
    "pricePerUnit": "{{pricePerUnit}}"
  }
}
